# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# Local: `npm run db:start` runs PostgreSQL 18 on :5433 (UTF-8, data in .pgdata).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/portfolio?schema=public"
#
# Production: any managed PostgreSQL; apply the same migrations with `npm run db:deploy`.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portfolio?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin used for canonical URLs, sitemap and cookies in production.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32+ random characters. Signs nothing by itself (sessions are random tokens
# hashed in the database) but is used for HMAC of the visitor rate-limit key.
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Number of reverse proxies in front of the app. The rate limiter trusts only
# the address appended by the outermost trusted proxy:
#   0 = app exposed directly (no proxy): X-Forwarded-For / X-Real-IP ignored
#   1 = one proxy (nginx, Caddy, Vercel, a single load balancer)
#   N = N chained proxies; the Nth address from the right is used
# Never set this higher than the number of proxies you actually control.
TRUSTED_PROXY_HOPS="1"
# X-Forwarded-Proto is informational only: cookies use `secure` whenever
# NODE_ENV=production, so terminate TLS at the proxy and forward HTTPS.

# HSTS: max-age is always sent in production. includeSubDomains is opt-in and
# must only be enabled after every subdomain is confirmed HTTPS-only. Do not
# submit the domain to the preload list from application code.
HSTS_INCLUDE_SUBDOMAINS="false"

# ---------------------------------------------------------------------------
# Backups (scripts/backup-db.sh, scripts/restore-db.sh)
# ---------------------------------------------------------------------------
BACKUP_DIR="./backups"
# Number of daily dumps to keep locally (oldest removed first).
BACKUP_KEEP="14"


# Optional: allow first-run admin setup over the network. When empty, the
# /admin/setup route only accepts requests from localhost.
SETUP_TOKEN=""

# ---------------------------------------------------------------------------
# Seed account (used once by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
# Dat mat khau manh rieng (>= 10 ky tu). Khong dung mat khau mau vi repo la public.
# (Set a strong password of your own, at least 10 chars. Never use a sample password: this repo is public.)
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Site Owner"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# local | s3
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
# Public base URL for /media/* (leave empty: served by the app at /media/...)
MEDIA_PUBLIC_BASE_URL=""
MAX_UPLOAD_MB="10"

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO, Backblaze B2...).
# Required only when STORAGE_DRIVER="s3". The credentials need s3:PutObject,
# s3:GetObject, s3:DeleteObject and s3:ListBucket: /api/ready calls HeadBucket,
# so a write-only policy reports the site as not ready.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Production preflight
# ---------------------------------------------------------------------------
# Run before every production build; it never prints values.
#   NODE_ENV=production node scripts/preflight.mjs
