// Prisma schema — Portfolio Studio
//
// PostgreSQL 18 (local dev runs a real server on :5433 via scripts/dev-db.mjs;
// production uses the same schema against a managed instance).
//
// Bilingual content uses dedicated translation tables keyed by (entity, locale)
// with a unique constraint, so adding a third language never changes a model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // SUPER_ADMIN (full access, users & settings) | ADMIN (content & messages)
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  articles     Article[]
  activityLogs ActivityLog[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the opaque token stored in the cookie; the raw token is never persisted.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Profile (singleton row, fully editable through the CMS)
// ---------------------------------------------------------------------------

model Profile {
  id               String   @id @default(cuid())
  email            String
  phone            String?
  location         String?
  avatarMediaId    String?
  resumeUrl        String?
  availableForWork Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  avatarMedia  Media?               @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  translations ProfileTranslation[]
}

model ProfileTranslation {
  id          String  @id @default(cuid())
  profileId   String
  locale      String
  fullName    String
  title       String
  shortBio    String
  longBio     String  @default("")
  // One interest per line: "Title | Description"
  interests   String  @default("")
  philosophy  String  @default("")
  futureGoals String  @default("")
  seoTitle    String?
  seoDescription String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([locale])
}

model Education {
  id          String   @id @default(cuid())
  institution String
  location    String?
  startYear   Int
  endYear     Int?
  isCurrent   Boolean  @default(false)
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations EducationTranslation[]

  @@index([order])
}

model EducationTranslation {
  id          String @id @default(cuid())
  educationId String
  locale      String
  degree      String
  field       String @default("")
  description String @default("")

  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, locale])
}

model Experience {
  id        String    @id @default(cuid())
  company   String
  location  String?
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  order     Int       @default(0)
  visible   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  translations ExperienceTranslation[]

  @@index([order])
}

model ExperienceTranslation {
  id           String @id @default(cuid())
  experienceId String
  locale       String
  role         String
  summary      String @default("")
  achievements String @default("")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("engineering")
  level     Int      @default(3)
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  label     String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id               String    @id @default(cuid())
  slug             String    @unique
  // product | platform | experiment — labels are localized in the UI
  category         String?
  thumbnailMediaId String?
  // completed | in_progress | archived
  status           String    @default("completed")
  startDate        DateTime?
  completionDate   DateTime?
  githubUrl        String?
  demoUrl          String?
  featured         Boolean   @default(false)
  // public | private
  visibility       String    @default("public")
  order            Int       @default(0)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  thumbnailMedia Media?   @relation("ProjectThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  translations   ProjectTranslation[]
  technologies   ProjectTechnology[]
  images         ProjectImage[]

  @@index([visibility, featured])
  @@index([category])
  @@index([order])
  @@index([deletedAt])
}

model ProjectTranslation {
  id               String @id @default(cuid())
  projectId        String
  locale           String
  name             String
  shortDescription String
  fullDescription  String @default("")
  role             String @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectTechnology {
  id        String @id @default(cuid())
  projectId String
  name      String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  mediaId   String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId])
}

// ---------------------------------------------------------------------------
// Digital art gallery
// ---------------------------------------------------------------------------

model ArtworkCollection {
  id               String    @id @default(cuid())
  slug             String    @unique
  coverMediaId     String?
  featured         Boolean   @default(false)
  order            Int       @default(0)
  visibility       String    @default("public")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  coverMedia   Media?                @relation("CollectionCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations CollectionTranslation[]
  artworks     Artwork[]

  @@index([visibility, order])
}

model CollectionTranslation {
  id           String @id @default(cuid())
  collectionId String
  locale       String
  name         String
  description  String @default("")

  collection ArtworkCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
}

model Artwork {
  id               String    @id @default(cuid())
  slug             String    @unique
  imageMediaId     String
  thumbnailMediaId String?
  collectionId     String?
  categoryId       String?
  medium           String?
  createdDate      DateTime?
  featured         Boolean   @default(false)
  order            Int       @default(0)
  // public | private
  visibility       String    @default("public")
  viewCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  imageMedia     Media              @relation("ArtworkImage", fields: [imageMediaId], references: [id], onDelete: Restrict)
  thumbnailMedia Media?             @relation("ArtworkThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  collection     ArtworkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  category       Category?          @relation("ArtworkCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  translations   ArtworkTranslation[]
  tags           ArtworkTag[]

  @@index([visibility, featured, order])
  @@index([collectionId])
  @@index([deletedAt])
}

model ArtworkTranslation {
  id          String @id @default(cuid())
  artworkId   String
  locale      String
  title       String
  description String @default("")

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([artworkId, locale])
  @@index([locale])
}

model ArtworkTag {
  artworkId String
  tagId     String

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artworkId, tagId])
}

// ---------------------------------------------------------------------------
// Blog & publishing
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  // article | artwork
  kind      String   @default("article")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  articles     Article[]
  artworks     Artwork[]             @relation("ArtworkCategory")

  @@index([kind, order])
}

model CategoryTranslation {
  id          String @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String @default("")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles ArticleTag[]
  artworks ArtworkTag[]
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  coverMediaId  String?
  categoryId    String?
  authorId      String
  // draft | published | archived
  status        String    @default("draft")
  // default | editorial — public presentation, never changes the content
  template      String    @default("default")
  publishedAt   DateTime?
  scheduledFor  DateTime?
  featured      Boolean   @default(false)
  visibility    String    @default("public")
  viewCount     Int       @default(0)
  readingMinutes Int      @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  coverMedia   Media?               @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  translations ArticleTranslation[]
  tags         ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([deletedAt])
}

model ArticleTranslation {
  id             String  @id @default(cuid())
  articleId      String
  locale         String
  title          String
  subtitle       String?
  excerpt        String  @default("")
  content        String  @default("")
  seoTitle       String?
  seoDescription String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model Media {
  id         String   @id @default(cuid())
  storageKey String   @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  alt        String?
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profileAvatars     Profile[]           @relation("ProfileAvatar")
  projectThumbnails  Project[]           @relation("ProjectThumbnail")
  projectImages      ProjectImage[]
  artworkImages      Artwork[]           @relation("ArtworkImage")
  artworkThumbnails  Artwork[]           @relation("ArtworkThumbnail")
  collectionCovers   ArtworkCollection[] @relation("CollectionCover")
  articleCovers      Article[]           @relation("ArticleCover")
  surveyCovers       Survey[]            @relation("SurveyCover")
  surveyBrandLogos   Survey[]            @relation("SurveyBrandLogo")

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Contact & site configuration
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  // unread | read | archived
  status    String    @default("unread")
  ip        String?
  userAgent String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([deletedAt])
}

model SiteSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType])
}

// ---------------------------------------------------------------------------
// Custom Survey System (Phase 10)
// ---------------------------------------------------------------------------

model Survey {
  id              String    @id @default(cuid())
  slug            String    @unique
  // draft | published | closed | archived  (zod enum; see src/lib/validation.ts)
  status          String    @default("draft")
  coverMediaId    String?
  // minimal | editorial | modern | premium | editorial-vn
  themePreset     String    @default("minimal")
  // layout: centered | split | editorial ; progressStyle: bar | dots | steps
  layout          String    @default("centered")
  progressStyle   String    @default("bar")
  // Validated hex colours, never raw CSS. Null = preset default.
  primaryColor    String?
  accentColor     String?
  backgroundColor String?
  surfaceColor    String?
  textColor       String?
  // Completion-badge gradient colours (validated hex, null = preset default).
  badgeFromColor  String?
  badgeToColor    String?
  // Brand header for the public survey/booking pages (15:14 photo reference):
  // brand name + logo shown in the top strip. Null = fall back to site brand.
  brandName       String?
  brandLogoMediaId String?
  // buttonStyle: solid | outline ; borderRadius: sm | md | lg | full (as String)
  buttonStyle     String    @default("solid")
  borderRadius    String    @default("md")
  estimatedMinutes Int?
  startsAt        DateTime?
  endsAt          DateTime?
  publishedAt     DateTime?
  // true = this survey may be chosen as a booking intake survey
  isBookingIntake Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  coverMedia   Media?              @relation("SurveyCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  brandLogoMedia Media?              @relation("SurveyBrandLogo", fields: [brandLogoMediaId], references: [id], onDelete: SetNull)
  translations SurveyTranslation[]
  sections     SurveySection[]
  questions    SurveyQuestion[]
  responses    SurveyResponse[]
  intakeFor    BookingService[]    @relation("IntakeSurvey")

  @@index([status, publishedAt])
  @@index([deletedAt])
}

model SurveyTranslation {
  id                String @id @default(cuid())
  surveyId          String
  locale            String
  title             String
  subtitle          String @default("")
  description       String @default("")
  introduction      String @default("")
  completionMessage String @default("")
  privacyNotice     String @default("")
  // Newline-separated custom bullet lines for the intro page; empty = no
  // custom bullets (the page falls back to its generated bullet list).
  highlights        String @default("")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, locale])
  @@index([locale])
}

model SurveySection {
  id       String @id @default(cuid())
  surveyId String
  order    Int    @default(0)

  survey       Survey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  translations SurveySectionTranslation[]
  questions    SurveyQuestion[]

  @@index([surveyId, order])
}

model SurveySectionTranslation {
  id          String @id @default(cuid())
  sectionId   String
  locale      String
  title       String
  description String @default("")

  section SurveySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
}

model SurveyQuestion {
  id        String  @id @default(cuid())
  surveyId  String
  sectionId String?
  // short_text | long_text | single_choice | multiple_choice | dropdown | rating | nps | yes_no
  type      String
  order     Int     @default(0)
  required  Boolean @default(false)
  minLength Int?
  maxLength Int?
  minRating Int?
  maxRating Int?

  survey       Survey            @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  section      SurveySection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  translations SurveyQuestionTranslation[]
  options      SurveyQuestionOption[]
  answers      SurveyAnswer[]

  @@index([surveyId, order])
  @@index([sectionId, order])
}

model SurveyQuestionTranslation {
  id          String @id @default(cuid())
  questionId  String
  locale      String
  title       String
  description String @default("")
  placeholder String @default("")

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, locale])
}

model SurveyQuestionOption {
  id         String @id @default(cuid())
  questionId String
  // Stable machine value (slugified label); the human label lives in translations.
  value      String
  order      Int    @default(0)

  question     SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations SurveyQuestionOptionTranslation[]
  answers      SurveyAnswer[]

  @@unique([questionId, value])
  @@index([questionId, order])
}

model SurveyQuestionOptionTranslation {
  id       String @id @default(cuid())
  optionId String
  locale   String
  label    String

  option SurveyQuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

model SurveyResponse {
  id            String   @id @default(cuid())
  surveyId      String
  // Locale the respondent answered in; answers join questions via questionId.
  locale        String
  // Null for anonymous. When the survey is "identified", store sha256(lower(email))
  // — the same hashedKey() pattern as the rate limiter — never the raw email.
  // @@unique([surveyId, respondentKey]) enforces one response per identified
  // respondent; Postgres treats NULLs as distinct, so anonymous responses
  // are unaffected.
  respondentKey String?
  submittedAt   DateTime @default(now())
  // No ip / userAgent columns by design (prompt §10.1). No name/email/phone
  // columns: identification lives in Booking when linked, or in answers.

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]
  booking Booking?

  @@unique([surveyId, respondentKey])
  @@index([surveyId, submittedAt])
}

model SurveyAnswer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  // For choice questions, the selected option (SetNull keeps the answer row
  // readable if the option is later removed). For rating/nps, the number as
  // text. For text, the text itself. One row per selected option for
  // multiple_choice (never a JSON array — this schema has no Json columns).
  optionId   String?
  value      String

  response SurveyResponse       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  option   SurveyQuestionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([responseId, questionId])
}

// ---------------------------------------------------------------------------
// Booking (Phase 10) — consultation appointments + flower code name
// ---------------------------------------------------------------------------

model BookingService {
  id              String   @id @default(cuid())
  slug            String   @unique
  durationMinutes Int      @default(30) // 15 | 30 | 60 (zod enum)
  active          Boolean  @default(true)
  intakeSurveyId  String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  intakeSurvey Survey?                   @relation("IntakeSurvey", fields: [intakeSurveyId], references: [id], onDelete: SetNull)
  translations BookingServiceTranslation[]
  slots        BookingSlot[]
  bookings     Booking[]

  @@index([active, order])
}

model BookingServiceTranslation {
  id          String @id @default(cuid())
  serviceId   String
  locale      String
  name        String
  description String @default("")

  service BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model BookingSlot {
  id        String   @id @default(cuid())
  serviceId String
  // Stored in UTC; displayed in Asia/Ho_Chi_Minh.
  startsAt  DateTime
  endsAt    DateTime
  // available | booked | blocked
  status    String   @default("available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service  BookingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([serviceId, startsAt])
  @@index([serviceId, startsAt, status])
}

model Booking {
  id               String    @id @default(cuid())
  // BK- + 6-char public reference, unambiguous alphabet (no 0/O, 1/I/l).
  // Shown to the visitor; cancel/lookup requires referenceCode + email together.
  referenceCode    String    @unique
  serviceId        String
  slotId           String
  surveyResponseId String?   @unique
  name             String
  email            String
  phone            String?
  notes            String    @default("")
  // Flower code name — see src/lib/flowers.ts (e.g. "tulip"). Kept forever as
  // history; uniqueness among ACTIVE bookings is enforced by the partial index
  // in the migration, NOT by nulling this column on cancel/complete.
  flowerCode       String
  // pending | confirmed | completed | cancelled
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cancelledAt      DateTime?

  service        BookingService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  slot           BookingSlot     @relation(fields: [slotId], references: [id], onDelete: Restrict)
  surveyResponse SurveyResponse? @relation(fields: [surveyResponseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([serviceId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Schedule JSON Import (Phase 11) — imported schedules + import history
// ---------------------------------------------------------------------------

model IntegrationConnection {
  id        String    @id @default(cuid())
  name      String
  // SHA-256 of the opaque `imp_…` token; the raw token is never persisted.
  tokenHash String    @unique
  autoApply Boolean   @default(false)
  isActive  Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schedules ImportedSchedule[]
  imports   ScheduleImport[]

  @@index([isActive])
}

model ImportedSchedule {
  id           String   @id @default(cuid())
  // Null = manual admin import scope; a connection id = that connection's
  // scope. Manual and API scopes never match each other (engine, D5).
  // NOTE (D1 deviation, see engine.ts): D1 wrote `connectionId String`
  // (non-null), but a null manual scope cannot be stored in a non-null FK
  // column, so this is nullable. The @@unique below does not fire for NULL
  // connectionId (Postgres treats NULLs as distinct); a partial unique
  // index in the migration covers the manual scope instead.
  connectionId String?
  externalId   String
  title        String
  description  String   @default("")
  location     String   @default("")
  note         String   @default("")
  // Stored in UTC; displayed in Asia/Ho_Chi_Minh (same rule as BookingSlot).
  startsAt     DateTime
  endsAt       DateTime
  // scheduled | confirmed | completed | cancelled
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, externalId])
  @@index([connectionId, startsAt])
  @@index([status, startsAt])
}

model ScheduleImport {
  id             String    @id @default(cuid())
  // Null = manual admin import.
  connectionId   String?
  source         String
  // completed | completed_with_errors | failed
  status         String
  totalRecords   Int
  createdCount   Int
  updatedCount   Int
  unchangedCount Int
  cancelledCount Int
  failedCount    Int
  importKey      String?
  payloadHash    String?
  createdByUserId String?
  // Short message only, never a stack trace.
  errorSummary   String?
  createdAt      DateTime  @default(now())

  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  items      ScheduleImportItem[]

  // Postgres NULLs are distinct, so manual imports (importKey null) never
  // collide on this.
  @@unique([connectionId, importKey])
  @@index([connectionId, createdAt])
  @@index([status, createdAt])
}

model ScheduleImportItem {
  id         String   @id @default(cuid())
  importId   String
  externalId String
  // created | updated | unchanged | cancelled | failed
  action     String
  // Short message only.
  error      String?
