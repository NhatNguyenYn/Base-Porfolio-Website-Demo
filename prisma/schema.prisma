// Prisma schema — Portfolio Studio
//
// PostgreSQL 18 (local dev runs a real server on :5433 via scripts/dev-db.mjs;
// production uses the same schema against a managed instance).
//
// Bilingual content uses dedicated translation tables keyed by (entity, locale)
// with a unique constraint, so adding a third language never changes a model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // SUPER_ADMIN (full access, users & settings) | ADMIN (content & messages)
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  articles     Article[]
  activityLogs ActivityLog[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the opaque token stored in the cookie; the raw token is never persisted.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Profile (singleton row, fully editable through the CMS)
// ---------------------------------------------------------------------------

model Profile {
  id               String   @id @default(cuid())
  email            String
  phone            String?
  location         String?
  avatarMediaId    String?
  resumeUrl        String?
  availableForWork Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  avatarMedia  Media?               @relation("ProfileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  translations ProfileTranslation[]
}

model ProfileTranslation {
  id          String  @id @default(cuid())
  profileId   String
  locale      String
  fullName    String
  title       String
  shortBio    String
  longBio     String  @default("")
  // One interest per line: "Title | Description"
  interests   String  @default("")
  philosophy  String  @default("")
  futureGoals String  @default("")
  seoTitle    String?
  seoDescription String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([locale])
}

model Education {
  id          String   @id @default(cuid())
  institution String
  location    String?
  startYear   Int
  endYear     Int?
  isCurrent   Boolean  @default(false)
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations EducationTranslation[]

  @@index([order])
}

model EducationTranslation {
  id          String @id @default(cuid())
  educationId String
  locale      String
  degree      String
  field       String @default("")
  description String @default("")

  education Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, locale])
}

model Experience {
  id        String    @id @default(cuid())
  company   String
  location  String?
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  order     Int       @default(0)
  visible   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  translations ExperienceTranslation[]

  @@index([order])
}

model ExperienceTranslation {
  id           String @id @default(cuid())
  experienceId String
  locale       String
  role         String
  summary      String @default("")
  achievements String @default("")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("engineering")
  level     Int      @default(3)
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  label     String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id               String    @id @default(cuid())
  slug             String    @unique
  // product | platform | experiment — labels are localized in the UI
  category         String?
  thumbnailMediaId String?
  // completed | in_progress | archived
  status           String    @default("completed")
  startDate        DateTime?
  completionDate   DateTime?
  githubUrl        String?
  demoUrl          String?
  featured         Boolean   @default(false)
  // public | private
  visibility       String    @default("public")
  order            Int       @default(0)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  thumbnailMedia Media?   @relation("ProjectThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  translations   ProjectTranslation[]
  technologies   ProjectTechnology[]
  images         ProjectImage[]

  @@index([visibility, featured])
  @@index([category])
  @@index([order])
  @@index([deletedAt])
}

model ProjectTranslation {
  id               String @id @default(cuid())
  projectId        String
  locale           String
  name             String
  shortDescription String
  fullDescription  String @default("")
  role             String @default("")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectTechnology {
  id        String @id @default(cuid())
  projectId String
  name      String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  mediaId   String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId])
}

// ---------------------------------------------------------------------------
// Digital art gallery
// ---------------------------------------------------------------------------

model ArtworkCollection {
  id               String    @id @default(cuid())
  slug             String    @unique
  coverMediaId     String?
  featured         Boolean   @default(false)
  order            Int       @default(0)
  visibility       String    @default("public")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  coverMedia   Media?                @relation("CollectionCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations CollectionTranslation[]
  artworks     Artwork[]

  @@index([visibility, order])
}

model CollectionTranslation {
  id           String @id @default(cuid())
  collectionId String
  locale       String
  name         String
  description  String @default("")

  collection ArtworkCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
}

model Artwork {
  id               String    @id @default(cuid())
  slug             String    @unique
  imageMediaId     String
  thumbnailMediaId String?
  collectionId     String?
  categoryId       String?
  medium           String?
  createdDate      DateTime?
  featured         Boolean   @default(false)
  order            Int       @default(0)
  // public | private
  visibility       String    @default("public")
  viewCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  imageMedia     Media              @relation("ArtworkImage", fields: [imageMediaId], references: [id], onDelete: Restrict)
  thumbnailMedia Media?             @relation("ArtworkThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  collection     ArtworkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  category       Category?          @relation("ArtworkCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  translations   ArtworkTranslation[]
  tags           ArtworkTag[]

  @@index([visibility, featured, order])
  @@index([collectionId])
  @@index([deletedAt])
}

model ArtworkTranslation {
  id          String @id @default(cuid())
  artworkId   String
  locale      String
  title       String
  description String @default("")

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([artworkId, locale])
  @@index([locale])
}

model ArtworkTag {
  artworkId String
  tagId     String

  artwork Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artworkId, tagId])
}

// ---------------------------------------------------------------------------
// Blog & publishing
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  // article | artwork
  kind      String   @default("article")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  articles     Article[]
  artworks     Artwork[]             @relation("ArtworkCategory")

  @@index([kind, order])
}

model CategoryTranslation {
  id          String @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String @default("")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles ArticleTag[]
  artworks ArtworkTag[]
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  coverMediaId  String?
  categoryId    String?
  authorId      String
  // draft | published | archived
  status        String    @default("draft")
  publishedAt   DateTime?
  scheduledFor  DateTime?
  featured      Boolean   @default(false)
  visibility    String    @default("public")
  viewCount     Int       @default(0)
  readingMinutes Int      @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  coverMedia   Media?               @relation("ArticleCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  translations ArticleTranslation[]
  tags         ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([deletedAt])
}

model ArticleTranslation {
  id             String  @id @default(cuid())
  articleId      String
  locale         String
  title          String
  subtitle       String?
  excerpt        String  @default("")
  content        String  @default("")
  seoTitle       String?
  seoDescription String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model Media {
  id         String   @id @default(cuid())
  storageKey String   @unique
  url        String
  filename   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  alt        String?
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profileAvatars     Profile[]           @relation("ProfileAvatar")
  projectThumbnails  Project[]           @relation("ProjectThumbnail")
  projectImages      ProjectImage[]
  artworkImages      Artwork[]           @relation("ArtworkImage")
  artworkThumbnails  Artwork[]           @relation("ArtworkThumbnail")
  collectionCovers   ArtworkCollection[] @relation("CollectionCover")
  articleCovers      Article[]           @relation("ArticleCover")

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Contact & site configuration
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  // unread | read | archived
  status    String    @default("unread")
  ip        String?
  userAgent String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([deletedAt])
}

model SiteSetting {
  key       String   @id
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType])
}
